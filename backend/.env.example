# Local Aezakmi Edge backend configuration.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/aezakmi.sqlite

# Use a strong random value of at least 32 characters in production.
JWT_SECRET=development-only-change-me
JWT_EXPIRES_IN=8h
SESSION_IDLE_TIMEOUT_MINUTES=10
SESSION_HEARTBEAT_SECONDS=10

# Development can use *. Production must explicitly list allowed app origins.
CORS_ORIGIN=*
TRUST_PROXY=false
DISKLESS_PROVIDER=icafe8
SERVER_NAME=Aezakmi Cafe Server

# Supabase cloud sync. Only public project configuration belongs on the cafe Edge.
# Keep privileged Supabase server credentials off the cafe machine.
AEZAKMI_CLOUD_ENABLED=false
AEZAKMI_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
AEZAKMI_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
AEZAKMI_CLOUD_SYNC_INTERVAL_SECONDS=5
AEZAKMI_CLOUD_SYNC_BATCH_SIZE=100
AEZAKMI_CLOUD_REQUEST_TIMEOUT_MS=8000
AEZAKMI_EDGE_VERSION=1.0.0

# Development convenience only. Ignored in production.
AEZAKMI_ALLOW_UNREGISTERED_DEV_STATION=false
