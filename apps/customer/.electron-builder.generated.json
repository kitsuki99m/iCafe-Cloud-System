{
  "appId": "com.icafe.customer",
  "productName": "iCafe Customer Station",
  "directories": {
    "output": "installer"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "icon": "electron/app-icon.ico",
  "extraResources": [
    "electron/windows-key-hook.ps1"
  ],
  "win": {
    "target": "nsis",
    "icon": "electron/app-icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "license": "TERMS_AND_CONDITIONS.txt",
    "runAfterFinish": true,
    "include": "installer.nsh"
  },
  "artifactName": "iCafe Customer Station Setup ${version}-${arch}.${ext}"
}
