# Optional development/build fallback only. Packaged Electron uses the saved runtime Server Connection first.
VITE_API_BASE_URL=
# Development normally uses the Vite /api proxy. Packaged Customer Stations use
# Cloud first and the saved cashier/Admin Café Edge LAN address as fallback.

# Cloud-primary Customer Station transport. These are public browser/Electron build values, not secrets.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
